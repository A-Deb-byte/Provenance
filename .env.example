# Provider credentials stay server-side. Any key below can instead be stored
# in the OS vault with PUT /api/vault/secrets/<NAME>; the API never returns
# secret values. Do not commit a populated .env file.
# GEMINI_API_KEY="..."
# OPENAI_API_KEY="..."
# OPENROUTER_API_KEY="..."
# DEEPSEEK_API_KEY="..."
# ZAI_API_KEY="..."

# Application AI uses the normalized provider router. This configuration pins
# it to OpenRouter's free-model router, which selects an eligible free model per
# request. Free-provider availability and data-use policies vary; do not send
# confidential data without reviewing the selected provider's policy.
AI_PROVIDER="openrouter"
AI_MODEL="openrouter/free"
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_MODELS="openrouter/free"

# Optional per-provider default and allowlist overrides (comma-separated).
# GEMINI_MODEL="gemini-3.5-flash"
# GEMINI_MODELS="gemini-3.5-flash,gemini-2.5-flash"
# OPENAI_MODEL="gpt-5.6"
# OPENAI_MODELS="gpt-5.6,gpt-5.6-terra,gpt-5.6-luna"
# DEEPSEEK_MODEL="deepseek-v4-flash"
# DEEPSEEK_MODELS="deepseek-v4-flash,deepseek-v4-pro"
# ZAI_MODEL="glm-5.1"
# ZAI_MODELS="glm-5.1,glm-5,glm-4.7"

# CORE_MODEL_PATH: Optional path to local MiniCPM5-1B GGUF weights for the
# in-process advisory core model. Defaults to .agent-kernel/models/minicpm5-1b.gguf
# The feature reports itself unavailable until the file exists.
# CORE_MODEL_PATH="C:\\path\\to\\minicpm5-1b.gguf"

# CORE_MODEL_INJECTION_ASSESSMENT: Opt-in. When set, untrusted observations are
# also scored by the core model (tighten-only, on top of the deterministic
# heuristics). Off by default because MiniCPM-1B over-flags benign content;
# enable only with a more capable local model.
# CORE_MODEL_INJECTION_ASSESSMENT="1"

# WEB_INSPECT_ORIGINS: Comma-separated canonical origins the read-only
# web-inspect worker may fetch (e.g. "https://example.com,https://docs.python.org").
# This also bounds Research to Verified Report missions: each mission accepts
# 1-5 explicit, unique HTTPS seed URLs, and every seed origin must appear here.
# Missions do not search, discover URLs, follow redirects, or widen this scope.
# Capture is L0 read-only and persists bounded, hash-addressed source artifacts.
# Keep this list narrow. The worker and research cockpit stay unavailable until
# at least one origin is configured.
# WEB_INSPECT_ORIGINS="https://example.com"

# Durable recurring research uses fixed HTTPS sources from WEB_INSPECT_ORIGINS
# and a latest-once interval trigger. The server clock is enabled by default;
# each schedule is still created disabled and requires an authenticated,
# explicit enable action. RELEASE_CHILD_MODE processes never start this clock.
# Set false to disable the scheduler for the main server. Tick frequency is
# clamped to 1000-60000 ms; durable schedule intervals remain independently
# bounded by the kernel.
# RECURRING_RESEARCH_SCHEDULER_ENABLED="true"
# RECURRING_RESEARCH_TICK_MS="15000"

# RELEASE_SIGNING_PUBLIC_KEY: Base64 Ed25519 public key (SPKI DER) used to
# verify release proposal signatures. Generate a keypair with:
#   node scripts/release-signing.mjs generate <privateKeyFile>
# Sign a proposal JSON document containing targetVersion, contentHash,
# evaluationEventIds, and rollbackInstructions with:
#   node scripts/release-signing.mjs sign <privateKeyFile> <proposalJsonFile>
# Release activation stays blocked until this is configured.
# RELEASE_SIGNING_PUBLIC_KEY="base64-spki-der"

# KERNEL_API_TOKEN: Optional shared operator token. Used only when no user
# accounts exist. When set, every mutating (non-GET) kernel and vault API
# request must send "Authorization: Bearer <token>". Reads stay open on loopback.
# KERNEL_API_TOKEN="choose-a-long-random-value"

# SESSION_SECRET: Optional HMAC secret for signing multi-user session tokens.
# If unset, a random per-process secret is generated (sessions reset on restart).
# Multi-user mode activates automatically once any account exists
# (POST /api/auth/users bootstraps the first admin; when KERNEL_API_TOKEN is
# configured, bootstrap must present that operator token).
# SESSION_SECRET="choose-a-long-random-value"

# BROWSER_WRITE_ORIGINS: Comma-separated origins the write-capable Playwright
# browser worker may navigate/click/type. The worker registers only when this
# is set AND a Chromium browser is installed for playwright-core:
#   npx playwright install chromium
# Otherwise the browser write worker stays unavailable.
# Text entry stages its value first via POST /api/kernel/artifacts (the intent
# references the artifact by id + sha256 hash, so untrusted content cannot
# inject keystrokes).
# BROWSER_WRITE_ORIGINS="https://example.com"

# Command-execution isolation: when a Docker daemon is reachable, verification
# commands run in an ephemeral container (no network, read-only root, bounded
# 2g memory / 512 pids / 2 cpu, workspace-only mount). No configuration needed;
# the runtime report shows "osSandbox: available" when Docker is present.
# DOCKER_PATH: full path to the docker executable if it is not on PATH
# (e.g. Docker Desktop on Windows). Use forward slashes; dotenv treats values
# literally and does not process backslash escapes.
# DOCKER_PATH="C:/Program Files/Docker/Docker/resources/bin/docker.exe"
