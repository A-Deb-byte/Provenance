# GEMINI_API_KEY: Optional server-side key for cloud chat, extraction, and
# mutation endpoints. When absent, chat and extraction run on the local core
# model if its weights are installed. Can also be stored in the OS vault
# (PUT /api/vault/secrets/GEMINI_API_KEY) instead of this file on Windows.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# CORE_MODEL_PATH: Optional path to local MiniCPM5-1B GGUF weights for the
# in-process advisory core model. Defaults to .agent-kernel/models/minicpm5-1b.gguf
# The feature reports itself unavailable until the file exists.
# CORE_MODEL_PATH="C:\\path\\to\\minicpm5-1b.gguf"

# WEB_INSPECT_ORIGINS: Comma-separated canonical origins the read-only
# web-inspect worker may fetch (e.g. "https://example.com,https://docs.python.org").
# The browser worker family stays unavailable until this allowlist is set.
# WEB_INSPECT_ORIGINS="https://example.com"

# RELEASE_SIGNING_PUBLIC_KEY: Base64 Ed25519 public key (SPKI DER) used to
# verify release proposal signatures. Generate a keypair with:
#   node scripts/release-signing.mjs generate <privateKeyFile>
# Release activation stays blocked until this is configured.
# RELEASE_SIGNING_PUBLIC_KEY="base64-spki-der"

# KERNEL_API_TOKEN: Optional shared operator token. Used only when no user
# accounts exist. When set, every mutating (non-GET) kernel and vault API
# request must send "Authorization: Bearer <token>". Reads stay open on loopback.
# KERNEL_API_TOKEN="choose-a-long-random-value"

# SESSION_SECRET: Optional HMAC secret for signing multi-user session tokens.
# If unset, a random per-process secret is generated (sessions reset on restart).
# Multi-user mode activates automatically once any account exists
# (POST /api/auth/users bootstraps the first admin on loopback).
# SESSION_SECRET="choose-a-long-random-value"

# BROWSER_WRITE_ORIGINS: Comma-separated origins the write-capable Playwright
# browser worker may navigate/click. The worker registers only when this is set
# AND a Chromium browser is installed for playwright-core:
#   npx playwright install chromium
# Otherwise the browser write worker stays unavailable.
# BROWSER_WRITE_ORIGINS="https://example.com"

# Command-execution isolation: when a Docker daemon is reachable, verification
# commands run in an ephemeral container (no network, read-only root, bounded
# 2g memory / 512 pids / 2 cpu, workspace-only mount). No configuration needed;
# the runtime report shows "osSandbox: available" when Docker is present.
# DOCKER_PATH: full path to the docker executable if it is not on PATH
# (e.g. Docker Desktop on Windows).
# DOCKER_PATH="C:\\Program Files\\Docker\\Docker\\resources\\bin\\docker.exe"
