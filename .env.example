# Provider credentials stay server-side. Any key below can instead be stored
# in the OS vault with PUT /api/vault/secrets/<NAME>; the API never returns
# secret values. Do not commit a populated .env file.
# GEMINI_API_KEY="..."
# OPENAI_API_KEY="..."
# OPENROUTER_API_KEY="..."
# DEEPSEEK_API_KEY="..."
# ZAI_API_KEY="..."

# Application AI uses the normalized provider router. This configuration pins
# it to OpenRouter's free-model router, which selects an eligible free model per
# request. Free-provider availability and data-use policies vary; do not send
# confidential data without reviewing the selected provider's policy.
AI_PROVIDER="openrouter"
AI_MODEL="openrouter/free"
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_MODELS="openrouter/free"

# Optional per-provider default and allowlist overrides (comma-separated).
# GEMINI_MODEL="gemini-3.5-flash"
# GEMINI_MODELS="gemini-3.5-flash,gemini-2.5-flash"
# OPENAI_MODEL="gpt-5.6"
# OPENAI_MODELS="gpt-5.6,gpt-5.6-terra,gpt-5.6-luna"
# DEEPSEEK_MODEL="deepseek-v4-flash"
# DEEPSEEK_MODELS="deepseek-v4-flash,deepseek-v4-pro"
# ZAI_MODEL="glm-5.1"
# ZAI_MODELS="glm-5.1,glm-5,glm-4.7"

# CORE_MODEL_PATH: Optional path to local MiniCPM5-1B GGUF weights for the
# in-process advisory core model. Defaults to .agent-kernel/models/minicpm5-1b.gguf
# The feature reports itself unavailable until the file exists.
# CORE_MODEL_PATH="C:\\path\\to\\minicpm5-1b.gguf"

# CORE_MODEL_INJECTION_ASSESSMENT: Opt-in. When set, untrusted observations are
# also scored by the core model (tighten-only, on top of the deterministic
# heuristics). Off by default because MiniCPM-1B over-flags benign content;
# enable only with a more capable local model.
# CORE_MODEL_INJECTION_ASSESSMENT="1"

# WEB_INSPECT_ORIGINS: Comma-separated canonical origins the read-only
# web-inspect worker may fetch (e.g. "https://example.com,https://docs.python.org").
# This also bounds Research to Verified Report missions: each mission accepts
# 1-5 explicit, unique HTTPS seed URLs, and every seed origin must appear here.
# Missions do not search, discover URLs, follow redirects, or widen this scope.
# Capture is L0 read-only and persists bounded, hash-addressed source artifacts.
# Keep this list narrow. The worker and research cockpit stay unavailable until
# at least one origin is configured.
# WEB_INSPECT_ORIGINS="https://example.com"

# Durable recurring research uses fixed HTTPS sources from WEB_INSPECT_ORIGINS
# and a latest-once interval trigger. The server clock is enabled by default;
# each schedule is still created disabled and requires an authenticated,
# explicit enable action. RELEASE_CHILD_MODE processes never start this clock.
# Set false to disable the scheduler for the main server. Tick frequency is
# clamped to 1000-60000 ms; durable schedule intervals remain independently
# bounded by the kernel.
# RECURRING_RESEARCH_SCHEDULER_ENABLED="true"
# RECURRING_RESEARCH_TICK_MS="15000"

# RELEASE_SIGNING_PUBLIC_KEY: Base64 Ed25519 public key (SPKI DER) used to
# verify release proposal signatures. Generate a keypair with:
#   node scripts/release-signing.mjs generate <privateKeyFile>
# Sign a proposal JSON document containing targetVersion, contentHash,
# evaluationEventIds, and rollbackInstructions with:
#   node scripts/release-signing.mjs sign <privateKeyFile> <proposalJsonFile>
# Release activation stays blocked until this is configured.
# RELEASE_SIGNING_PUBLIC_KEY="base64-spki-der"

# Production Desktop Release v1 uses a separate release-only trust contract.
# These values are consumed by `npm run desktop:release:plan` and
# `npm run desktop:release:build`; they are not dashboard configuration.
# Keep private keys and certificate material in the protected CI environment,
# not in .env. The public/ordinary examples below contain no usable authority.
#
# Exact Windows x64 Node runtime and its LICENSE file. Both files, the declared
# Node version, and both SHA-256 values must match before packaging begins.
# The GitHub workflow additionally uses PROVENANCE_BUNDLED_NODE_URL and
# PROVENANCE_BUNDLED_NODE_ARCHIVE_SHA256 as repository variables to download
# and verify the distribution archive before discovering these two files.
# PROVENANCE_BUNDLED_NODE="C:\\release-inputs\\node.exe"
# PROVENANCE_BUNDLED_NODE_SHA256="64-lowercase-hex-characters"
# PROVENANCE_BUNDLED_NODE_VERSION="v22.x.y"
# PROVENANCE_BUNDLED_NODE_SIGNER_THUMBPRINT="40-uppercase-hex-characters"
# PROVENANCE_BUNDLED_NODE_LICENSE="C:\\release-inputs\\LICENSE"
# PROVENANCE_BUNDLED_NODE_LICENSE_SHA256="64-lowercase-hex-characters"
# The protected job uses a distinct
# PROVENANCE_PRODUCTION_BUNDLED_NODE_SIGNER_THUMBPRINT variable with the same
# exact vendor signer identity; both jobs verify its timestamp before execution.
#
# Base64 transport of the exact two-line public Tauri minisign key and a
# query-free public HTTPS manifest. Raw minisign text is rejected.
# The GitHub publication workflow requires the repository-specific form
# https://github.com/<owner>/<repo>/releases/latest/download/latest.json.
# PROVENANCE_UPDATER_PUBLIC_KEY="base64-encoded-two-line-minisign-public-key"
# PROVENANCE_UPDATER_ENDPOINT="https://github.com/owner/repo/releases/latest/download/latest.json"
#
# Authenticode and command-isolation release policy. The certificate must
# already exist in the Windows certificate store. The sandbox image is fixed
# into the native binary and must use registry/repository@sha256:<digest>.
# PROVENANCE_WINDOWS_CERTIFICATE_THUMBPRINT="40-uppercase-hex-characters"
# PROVENANCE_WINDOWS_TIMESTAMP_URL="https://timestamp.example.com/"
# PROVENANCE_SANDBOX_IMAGE="registry.example.com/provenance/sandbox@sha256:64-lowercase-hex-characters"
#
# Protected secrets expected by the release workflow, shown only by name:
# TAURI_SIGNING_PRIVATE_KEY
# TAURI_SIGNING_PRIVATE_KEY_PASSWORD
# PROVENANCE_WINDOWS_PFX_BASE64
# PROVENANCE_WINDOWS_PFX_PASSWORD

# KERNEL_API_TOKEN: Optional shared operator token. Used only when no user
# accounts exist. When set, every mutating (non-GET) kernel and vault API
# request must send "Authorization: Bearer <token>". Authoritative kernel reads
# also require a bearer outside open mode; only sanitized status routes remain
# public for login-time availability reporting.
# KERNEL_API_TOKEN="choose-a-long-random-value"

# SESSION_SECRET: Optional HMAC secret for signing multi-user session tokens.
# If unset, a random per-process secret is generated (sessions reset on restart).
# Multi-user mode activates automatically once any account exists
# (POST /api/auth/users bootstraps the first admin; when KERNEL_API_TOKEN is
# configured, bootstrap must present that operator token).
# SESSION_SECRET="choose-a-long-random-value"

# BROWSER_WRITE_ORIGINS: Comma-separated origins the write-capable Playwright
# browser worker may navigate/click/type. The worker registers only when this
# is set AND a Chromium browser is installed for playwright-core:
#   npx playwright install chromium
# Otherwise the browser write worker stays unavailable.
# Text entry stages its value first via POST /api/kernel/artifacts (the intent
# references the artifact by id + sha256 hash, so untrusted content cannot
# inject keystrokes).
# BROWSER_WRITE_ORIGINS="https://example.com"

# Native desktop development is Windows-only and refuses to register unless
# access control is configured through KERNEL_API_TOKEN or multi-user accounts.
# The allowlist is canonical JSON with 1-32 unique entries. appId accepts only
# lowercase letters, digits, dot, underscore, and hyphen; executablePath must be
# an absolute, normalized .exe path with no ".." segment.
# DESKTOP_APP_ALLOWLIST='[{"appId":"windows.notepad","executablePath":"C:\\Windows\\System32\\notepad.exe"}]'
# npm run desktop:dev preloads .env before starting Tauri so the development
# host receives this allowlist. Packaged releases ignore this environment
# authority and use an explicitly confirmed per-user native selection.

# Native development defaults to the current repository and the standard
# 64-bit Node installation. Override only with canonical absolute paths.
# PROVENANCE_PROJECT_ROOT="C:\\path\\to\\Provenance"
# PROVENANCE_NODE_EXECUTABLE="C:\\Program Files\\nodejs\\node.exe"
# PROVENANCE_WORKSPACE_ROOT="C:\\path\\to\\a\\project"
# PROVENANCE_RUNTIME_DIR is selected by the native host under per-user local
# application data. Standalone Node keeps the repository-local .agent-kernel
# default. Do not set this native child value in .env.

# DESKTOP_BRIDGE_URL, DESKTOP_BRIDGE_TOKEN, DESKTOP_RUNTIME_OWNER_NONCE,
# DESKTOP_RUNTIME_OWNER_PID, DESKTOP_HOST_NONCE, and DESKTOP_HOST_READY_FILE are
# per-launch values supplied to the supervised Node process by the trusted
# native host. Do not configure, persist, or reuse them in an operator .env.

# Command-execution isolation: a Docker daemon must successfully run the
# configured image against the exact workspace before verification commands
# become available. Containers have no network, a read-only root, bounded
# 2g memory / 512 pids / 2 cpu, and a workspace-only mount. Native desktop
# launches disable command execution when Docker or the exact health probe is
# unavailable; only standalone source runs retain a reported trusted-host
# fallback. Packaged releases receive the digest-pinned image from the trusted
# native host, not from dashboard state.
# DOCKER_PATH: full path to the docker executable if it is not on PATH
# (e.g. Docker Desktop on Windows). Use forward slashes; dotenv treats values
# literally and does not process backslash escapes.
# DOCKER_PATH="C:/Program Files/Docker/Docker/resources/bin/docker.exe"
