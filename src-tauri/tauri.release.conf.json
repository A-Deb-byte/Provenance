{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "dev.provenance.desktop",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "publisher": "Provenance",
    "category": "Productivity",
    "shortDescription": "Local-first AI agent with a trusted native control plane.",
    "longDescription": "Provenance is a local-first AI agent whose native host supervises its kernel and mediates bounded Windows desktop automation.",
    "icon": ["icons/icon.ico"],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  }
}
